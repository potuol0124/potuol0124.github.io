# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋되지 않아요)

# Supabase Edge Function 주소. 비워두면 데모 데이터로 동작해요.
# 예: https://<project-ref>.supabase.co/functions/v1/nearby
VITE_API_URL=

# Supabase 프로젝트의 anon(public) 키. 공개돼도 되는 키예요.
VITE_SUPABASE_ANON_KEY=

# 앱인토스 콘솔 > 광고에서 발급한 광고 그룹 ID. 비워두면 광고를 띄우지 않아요.
VITE_AD_BANNER_ID=
VITE_AD_INTERSTITIAL_ID=

# 전면 광고를 몇 번째 검색마다 보여줄지 (기본 3)
VITE_AD_INTERSTITIAL_EVERY=3
