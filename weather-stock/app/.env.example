# 백엔드 모드: mock(기본, 서버 없이 브라우저에서 동작) | firebase
VITE_BACKEND=mock

# --- Firebase (VITE_BACKEND=firebase 일 때) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3
# 로컬 에뮬레이터를 쓰려면 true
VITE_FIREBASE_EMULATOR=false

# --- 앱인토스 콘솔에서 발급받는 값 ---
# 토스포인트 프로모션 코드 (콘솔 > 프로모션)
VITE_TOSS_PROMOTION_CODE=
# 광고 그룹 ID (콘솔 > 광고)
VITE_AD_BANNER_GROUP_ID=
VITE_AD_REWARDED_GROUP_ID=
