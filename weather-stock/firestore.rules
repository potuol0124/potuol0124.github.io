rules_version = '2';

// 클라이언트는 읽기만 해요. 돈·주식이 바뀌는 모든 쓰기는 Cloud Functions(관리자 권한)만 해요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /market/{doc} { allow read: if signedIn(); }
    match /history/{doc} { allow read: if signedIn(); }
    match /rankings/{doc} { allow read: if signedIn(); }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      match /{sub=**} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow write: if false;
    }
  }
}
